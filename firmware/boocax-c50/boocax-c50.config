CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3399-boocax-c50"
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3399-boocax-c50.dtb"
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
# CONFIG_TPL is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_VIDEO is not set
# CONFIG_MMC_HS400_SUPPORT is not set
CONFIG_BOOTSTD=y
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_BOOTMETH_SCRIPT=y
CONFIG_BOOTMETH_EXTLINUX=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTFLOW=y
CONFIG_CMD_BTRFS=y
